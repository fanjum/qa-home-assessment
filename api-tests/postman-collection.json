  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fresh email each run or we get 409",
                  "const id = Date.now();",
                  "const email = `qa_${id}@example.com`;",
                  "// set in both places so it works standalone or with an env",
                  "pm.collectionVariables.set('client_email', email);",
                  "if (pm.environment.name) pm.environment.set('client_email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const token = pm.response.json().accessToken;",
                  "pm.test('Token returned', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('auth_token', token);",
                  "if (pm.environment.name) pm.environment.set('auth_token', token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"clientName\":\"{{client_name}}\",\"clientEmail\":\"{{client_email}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api-clients",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-clients"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Happy Path",
      "item": [
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Array is not empty', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "",
                  "pm.test('Product schema is valid', () => {",
                  "  list.forEach(p => {",
                  "    pm.expect(p).to.have.all.keys('id', 'category', 'name', 'inStock');",
                  "    pm.expect(p.id).to.be.a('number');",
                  "    pm.expect(p.name).to.be.a('string');",
                  "  });",
                  "});",
                  "",
                  "const avail = list.find(p => p.inStock);",
                  "pm.test('Found in-stock item', () => pm.expect(avail).to.not.be.undefined);",
                  "pm.collectionVariables.set('product_id', avail.id);",
                  "if (pm.environment.name) pm.environment.set('product_id', avail.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const cid = pm.response.json().cartId;",
                  "pm.collectionVariables.set('cart_id', cid);",
                  "if (pm.environment.name) pm.environment.set('cart_id', cid);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/carts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":{{product_id}},\"quantity\":{{order_quantity}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/carts/{{cart_id}}/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carts",
                "{{cart_id}}",
                "items"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const oid = pm.response.json().orderId;",
                  "pm.test('Order ID returned', () => pm.expect(oid).to.be.a('string'));",
                  "pm.collectionVariables.set('order_id', oid);",
                  "if (pm.environment.name) pm.environment.set('order_id', oid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cartId\":\"{{cart_id}}\",\"customerName\":\"{{customer_name}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test('Details match submission', () => {",
                  "  pm.expect(order.customerName).to.eql(pm.collectionVariables.get('customer_name'));",
                  "  pm.expect(order.items[0].productId).to.eql(Number(pm.collectionVariables.get('product_id')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
